#!/bin/bash
# disk-check.sh - Show disk usage and warn when a filesystem is nearly full
# Usage: ./disk-check.sh [threshold_percent]   (default: 80)

THRESHOLD="${1:-80}"

echo "=== Disk Usage ($(hostname) - $(date '+%F %T')) ==="
df -hT -x tmpfs -x devtmpfs
echo

echo "=== Warnings (>= ${THRESHOLD}% used) ==="
warn=0
while read -r fs pct mount; do
    pct="${pct%\%}"
    if [ "$pct" -ge "$THRESHOLD" ]; then
        echo "WARNING: $mount ($fs) is ${pct}% full"
        warn=1
    fi
done < <(df -P -x tmpfs -x devtmpfs | awk 'NR>1 {print $1, $5, $6}')

[ "$warn" -eq 0 ] && echo "All filesystems are below ${THRESHOLD}%."
echo

echo "=== Top 5 largest directories in /var ==="
du -xh /var --max-depth=1 2>/dev/null | sort -rh | head -n 6

exit "$warn"
